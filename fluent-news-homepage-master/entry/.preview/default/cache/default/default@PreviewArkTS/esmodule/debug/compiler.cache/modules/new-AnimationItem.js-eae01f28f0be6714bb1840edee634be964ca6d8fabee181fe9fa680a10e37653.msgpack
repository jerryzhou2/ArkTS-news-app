AnimationItem.prototype.onCanvasHasVisibleArea = function(canvasUniqueId, hasArea) {
  LogUtil.info(`${this._getLogTag()} canvas(${canvasUniqueId}) has ${hasArea ? 'visible' : 'no'} area.`);
