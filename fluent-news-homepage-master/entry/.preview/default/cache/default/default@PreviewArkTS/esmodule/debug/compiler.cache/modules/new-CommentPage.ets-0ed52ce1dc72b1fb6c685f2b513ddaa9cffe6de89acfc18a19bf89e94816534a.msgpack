  // æ·»åŠ æ–°è¯„è®º
  private addComment(): void {
    if (this.newComment && this.newComment.trim() !== '') {
      let now = new Date();
      let timeString = `${now.getHours()}:${now.getMinutes()}`;
      let comment = new CommentItem('æˆ‘', this.newComment, timeString);
      this.comments.push(comment); // æ·»åŠ åˆ°åˆ—è¡¨æœ«å°¾
      this.newComment = ''; // æ¸…ç©ºè¾“å…¥æ¡†
      
      // ä¿å­˜è¯„è®º
      this.saveComments();
      
      // æ›´æ–°æ–°é—»çš„è¯„è®ºæ•°
      this.newsItem.comments = this.comments.length;
    }
  }

  @Builder
