    let downloadTasks = [];
    let imgData = [];
    lottieData?.assets?.forEach((item, index) => {
      if (item.id && item.p && item.p.startsWith('http')) {
        let httpRequest = http.createHttp();
        let jsonData = [];
        httpRequest.on('dataReceive', (data) => {
          jsonData.push(data);
