    aboutToDisappear() {
        this.newsData.clear();
    }
    applyFilter() {
        this.newsData.clear();
        const keyword = this.searchKeyword ? this.searchKeyword.trim().toLowerCase() : '';
        if (keyword === '') {
            for (let i = CommonConstants.ZERO; i < this.allNews.length; i++) {
                this.newsData.pushData(this.allNews[i]);
            }
            return;
        }
        for (let i = CommonConstants.ZERO; i < this.allNews.length; i++) {
            const item = this.allNews[i];
            const title = String(item.newsTitle).toLowerCase();
            const content = String(item.newsContent).toLowerCase();
            if (title.indexOf(keyword) !== -1 || content.indexOf(keyword) !== -1) {
                this.newsData.pushData(item);
            }
        }
    }
    onSearchKeywordChange() {
        this.applyFilter();
    }
    rerender() {
        this.updateDirtyElements();
    }
