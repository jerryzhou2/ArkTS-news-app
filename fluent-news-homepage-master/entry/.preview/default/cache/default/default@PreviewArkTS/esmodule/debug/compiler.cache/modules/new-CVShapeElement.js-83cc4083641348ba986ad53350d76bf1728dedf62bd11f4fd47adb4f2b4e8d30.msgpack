        var lenss = 3;
        for (j = 0; j < lenss; j += 1) {
          if (color.length >= 3) {
            data[i].g.c[j * 4 + 1] = color[0];
            data[i].g.c[j * 4 + 2] = color[1];
            data[i].g.c[j * 4 + 3] = color[2];
          } else if (color.length === 2) {
            data[i].g.c[j * 4 + 1] = color[0];
            data[i].g.c[j * 4 + 2] = color[1];
          } else if (color.length === 1) {
            data[i].g.c[j * 4 + 1] = color[0];
          }
