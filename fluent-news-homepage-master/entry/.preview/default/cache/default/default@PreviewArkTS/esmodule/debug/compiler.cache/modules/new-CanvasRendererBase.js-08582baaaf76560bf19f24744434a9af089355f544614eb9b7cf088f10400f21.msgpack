    let currentTranform = this.canvasContext.getTransform();
    this.canvasContext.clearRect(0, 0, this.transformCanvas.w, this.transformCanvas.h); //æ¸…ç©ºä¹‹å‰ç”»å¸ƒ
    this.canvasContext.setTransform(1, 0, 0, 1, 0, 0);
    this.canvasContext.clearRect(0, 0, this.canvasContext.width, this.canvasContext.height); //æ¸…ç©ºä¹‹å‰ç”»å¸ƒ
    this.canvasContext.setTransform(currentTranform);
