          }
        }
        if (props.indexOf('fill') > -1) {
          color = svg['ks']['fill']
        }
        if (props.indexOf('clip-path') > -1) {
          let clipPathId = svg['ks']['clip-path']
          var isClip = false
          let count = 0
          for (let i = 0;i < svg['childs'].length; i++) {
