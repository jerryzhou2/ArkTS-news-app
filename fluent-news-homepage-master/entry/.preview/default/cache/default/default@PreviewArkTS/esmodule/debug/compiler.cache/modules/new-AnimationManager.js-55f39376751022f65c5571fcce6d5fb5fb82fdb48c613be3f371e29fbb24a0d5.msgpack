};

Looper.prototype._exportApiByFrameCallback = function() {
    // å¯¼å‡ºå¤–éƒ¨å¯è°ƒç”¨æ–¹æ³•(å†…éƒ¨æ–¹æ³•ä»¥"_"å¼€å¤´)
    this._looperType = 'frameCallback';

