    LogUtil.warn(`${this._getLogTag()} coordinator register canvas(${canvas.getUniqueId()}) callbacks.`);
    canvas.commonEvent.setOnVisibleAreaApproximateChange(
        { ratios: [0], expectedUpdateInterval: 500 },
