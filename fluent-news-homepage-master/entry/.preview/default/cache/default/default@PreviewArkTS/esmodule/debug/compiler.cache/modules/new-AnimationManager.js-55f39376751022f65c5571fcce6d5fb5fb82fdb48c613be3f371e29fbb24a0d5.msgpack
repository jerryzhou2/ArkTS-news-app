    context2d.on('onDetach', callbacks.onContext2dDetachedFromCanvas);

    let { canvas } = context2d; // G.MET.11 å»ºè®®ä½¿ç”¨å‚æ•°çš„è§£æ„
    if (canvas) {
        /* æ­¤æ—¶context2dæœ‰ä¸€ä¸ªå…³è”åˆ°çš„canvas. å®ƒä¸context2dæœ‰å¯èƒ½æ˜¯attachedçš„, ä¹Ÿæœ‰å¯èƒ½æ˜¯æ›¾ç»attachedè¿‡ä½†åˆè¢«detachedäº†.
         * ä¸ºé¿å…è¯¯åˆ¤é€ æˆæœ¬è¯¥æ´»åŠ¨è€Œæœªæ´»åŠ¨, æ­¤å¤„è§†å…¶ä¸ºattachedçš„canvasæ¥å¤„ç†, å¹¶åšä¸€æ¬¡å¿…è¦çš„"è¡¥è°ƒ"
         */
        LogUtil.warn(`${this._getLogTag()} canvas(${canvas.getUniqueId()}) indeterminate attached or not, treat it as attached.`);
