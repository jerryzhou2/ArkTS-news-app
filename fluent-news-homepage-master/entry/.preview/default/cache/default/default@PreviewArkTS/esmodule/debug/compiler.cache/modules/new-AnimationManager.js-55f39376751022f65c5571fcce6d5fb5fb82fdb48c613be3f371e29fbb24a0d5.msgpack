            preferredNoArea, // G.OBJ.03 æ¨èåœ¨å¯¹è±¡å­—é¢é‡ä¸­ä½¿ç”¨æ–¹æ³•ç®€å†™å’Œå±æ€§ç®€å†™
        },
        animation: undefined, // undefined:ä¸ç¡®å®šæ˜¯å¦ç»‘å®š
        canvasShadow: undefined, // undefined:ä¸ç¡®å®šæ˜¯å¦ç»‘å®š
    };
    this._context2dShadows.set(context2d, context2dShadow);
    LogUtil.info(`${this._getLogTag()} bind context2d(${context2dShadow._id}) to coordinator${preferredNoArea ?
