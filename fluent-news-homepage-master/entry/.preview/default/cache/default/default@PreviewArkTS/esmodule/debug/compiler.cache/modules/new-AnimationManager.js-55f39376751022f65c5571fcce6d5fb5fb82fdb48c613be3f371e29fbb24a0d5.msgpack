    let context2dShadow = this._context2dShadows.get(context2d);
    if (context2dShadow) {
        LogUtil.info(`${this._getLogTag()} context2d(${context2dShadow._id}) already attached to coordinator.`);
        context2dShadow.option.preferredNoArea = true;
