};

Coordinator.prototype._isNodeAndAncestorVisible = function (node) {
    if (!node) {
        return false;
    }

    let isVisible = node.isVisible();
    let parent = node.getParent();
    while (parent && isVisible) {
        isVisible = parent.isVisible();
        parent = parent.getParent();
    }
    return isVisible;
};

