            let originalFileName = pathSegments[pathSegments.length - 1]; // åŸå§‹æ–‡ä»¶åï¼ˆå«æ‰©å±•åï¼‰
            let cleanFileName = originalFileName.replace(/\.(?:zip|json)$/i, ''); // æ¸…ç†åæ–‡ä»¶åï¼ˆå»é™¤æ‰©å±•åï¼‰

            let lottieBaseDir = `${context.filesDir}/lottie/${parentDirName}`; // åŸºç¡€å­˜å‚¨ç›®å½•
            let targetDirectory = `${lottieBaseDir}/${cleanFileName}`; // ç›®æ ‡ç›®å½•

            // æ‰§è¡Œç›®å½•æ¸…ç†
            rmdir(targetDirectory, isSync);
        }

        // å¤„ç†å›¾ç‰‡èµ„æº
        if (container) {
            try {
                // è§£æèµ„æºä¸­çš„JSONæ•°æ®
                let jsonString = container.getJsonData(path);
                let jsonObj = JSON.parse(jsonString);

                // æ„å»ºå›¾ç‰‡åŠ è½½ç›®å½•è·¯å¾„
                let loadPath = `${context.filesDir}/lottie/loadImages/`;

                // æ£€æŸ¥æ˜¯å¦å­˜åœ¨ç½‘ç»œèµ„æº
                if (isExistNetworkAssets(jsonObj?.assets)) {
                    rmdir(loadPath, isSync, jsonObj);
                }
            } catch (error) {
                LogUtil.error(`JSONè§£æå¤±è´¥: ${error.message}`);
            }
        }
    }

    /**
     * å¼‚æ­¥æ¸…é™¤æ–‡ä»¶ç¼“å­˜
     * @param {string} url - è¦æ¸…é™¤ç¼“å­˜çš„æ–‡ä»¶URLæˆ–æœ¬åœ°è·¯å¾„
     * @param {Object|string} container - ç¼“å­˜å®¹å™¨å¯¹è±¡æˆ–ç›®å½•è·¯å¾„
     */
    function clearFileCache(url, container) {
        clearFile(url, container, false);
    }

    /**
     * åŒæ­¥æ¸…é™¤æ–‡ä»¶ç¼“å­˜
     * @param {string} url - è¦æ¸…é™¤ç¼“å­˜çš„æ–‡ä»¶URLæˆ–æœ¬åœ°è·¯å¾„
     * @param {Object|string} container - ç¼“å­˜å®¹å™¨å¯¹è±¡æˆ–ç›®å½•è·¯å¾„
     */
    function clearFileCacheSync(url, container) {
        clearFile(url, container, true);
    }

    /**
     * æ¸…ç†æ–‡ä»¶ç¼“å­˜ï¼ˆæ”¯æŒå•æ–‡ä»¶æˆ–å…¨å±€æ¸…ç†ï¼‰
     * @param {string} [url] - å¯é€‰çš„æ–‡ä»¶URLè·¯å¾„ï¼Œå­˜åœ¨æ—¶æ¸…ç†æŒ‡å®šæ–‡ä»¶ç¼“å­˜
     * @param {Object} container - åŒ…å«JSONæ•°æ®çš„å®¹å™¨å¯¹è±¡ï¼Œç”¨äºè§£æå…³è”èµ„æº
     * @param {boolean} isSync - æ˜¯å¦ä½¿ç”¨åŒæ­¥æ¨¡å¼æ‰§è¡Œæ¸…ç†æ“ä½œ
     */
    function clearFile(url, container, isSync) {
        // å®‰å…¨æ ¡éªŒï¼šç¡®ä¿ä¸Šä¸‹æ–‡å­˜åœ¨
        let context = getContext();
        if (!context) {
            return;
        }

        if (url) {
            // å•æ–‡ä»¶æ¸…ç†æ¨¡å¼ï¼šç²¾ç¡®æ¸…ç†æŒ‡å®šURLå¯¹åº”çš„ç¼“å­˜
            clearSingleFileCache(url, container, isSync);
            return;
        }
        let fileDir = `${context.filesDir}/lottie`; // åº”ç”¨ç§æœ‰æ–‡ä»¶ç›®å½•
        let cacheDir = `${context.cacheDir}/lottie`; // ç³»ç»Ÿç¼“å­˜ç›®å½•

        // æ‰§è¡Œæ¸…ç†æ“ä½œï¼ˆåŒæ­¥/å¼‚æ­¥æ¨¡å¼ï¼‰
        rmdir(fileDir, isSync);
        rmdir(cacheDir, isSync);
    }

    /**
     * åˆ é™¤æŒ‡å®šèµ„æºæ–‡ä»¶
     * @param {string} path - åŸºç¡€ç›®å½•è·¯å¾„
     * @param {Object} assets - èµ„æºå¯¹è±¡ï¼ŒåŒ…å«idå’Œp(è·¯å¾„)å±æ€§
     * @param {Array} filenames - æ–‡ä»¶åæ•°ç»„
     * @param {boolean} isSync - æ˜¯å¦åŒæ­¥åˆ é™¤æ ‡å¿—
     */
    function rmAssetsDir(path, assets, filenames, isSync) {
        // åˆ¤æ–­æ˜¯å¦ä¸ºHTTPèµ„æºï¼ˆé€šè¿‡æ£€æŸ¥è·¯å¾„æ˜¯å¦ä»¥httpå¼€å¤´ï¼‰
        let isHttp = assets?.p?.startsWith('http');

        if (isHttp) {
            // æ„é€ ç›®æ ‡æ–‡ä»¶åï¼ˆassets.id + '.png'ï¼‰
            const targetFilename = `${assets.id}.png`;
            const fileIndex = filenames.indexOf(targetFilename);

            // æ‰¾åˆ°åŒ¹é…æ–‡ä»¶æ—¶æ‰§è¡Œåˆ é™¤
            if (fileIndex !== -1) {
                if (isSync) {
                    unlinkSync(path + filenames[fileIndex]);
                } else {
                    unlink(path + filenames[fileIndex]);
                }
            }
        }
    }

    /**
     * æ ¹æ®è·¯å¾„åˆ é™¤æ–‡ä»¶æˆ–ç›®å½•
     * @param {string} path - åŸºç¡€ç›®å½•è·¯å¾„
     * @param {string} filename - æ–‡ä»¶/ç›®å½•å
     * @param {boolean} isSync - æ˜¯å¦åŒæ­¥æ“ä½œæ ‡å¿—
     */
    function rmDirByPath(path, filename, isSync) {
        let dirPath = path + '/' + filename;
        // åˆ¤æ–­æ˜¯å¦æ–‡ä»¶å¤¹
        try {
            let isDirectory = fs.statSync(dirPath).isDirectory();
            if (isDirectory) {
                rmdirSync(dirPath);
            } else {
                if (isSync) {
                    unlinkSync(dirPath);
                } else {
                    unlink(dirPath);
                }
            }
        } catch (err) {
            LogUtil.error('Method rmDirByPath execute error: ' + JSON.stringify(err));
        }
    }

    /**
     *  åˆ é™¤ç›®å½•
     * @param path - ç›®æ ‡æ ¹ç›®å½•è·¯å¾„
     * @param isSync - æ˜¯å¦åŒæ­¥æ“ä½œæ ‡å¿—
     * @param jsonObj - èµ„æºæè¿°å¯¹è±¡ï¼ˆå¯é€‰ï¼‰
     */
    function rmdir(path, isSync, jsonObj) {
        let filenames = listFileSyncs(path);
        if (jsonObj) {
            for (let i = 0; i < jsonObj.assets.length; i++) {
                rmAssetsDir(path, jsonObj.assets[i], filenames, isSync);
            }
        } else {
            for (let i = 0; i < filenames.length; i++) {
                rmDirByPath(path, filenames[i], isSync);
            }
        }
    }

